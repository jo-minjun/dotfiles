{
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true,
    "datadog@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "mermaid-view@claude-mermaid-view": false,
    "php-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "extraKnownMarketplaces": {
    "claude-mermaid-view": {
      "source": {
        "repo": "jo-minjun/claude-mermaid-view",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "fastMode": false,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/lockpaw\" ping --agent claude",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|agent_completed|quota_auto_resume_stale|quota_auto_resume_disabled"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME\"/.claude/hooks/sync-git-on-startup.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/lockpaw\" ping --agent claude",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/lockpaw\" ping --agent claude",
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "Korean",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Agent",
      "Bash(git:*)",
      "Bash(mkdir:*)",
      "Bash(./gradlew:*)",
      "Bash(javac:*)",
      "Bash(wget:*)",
      "Bash(curl:*)",
      "Bash(java:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(cp:*)",
      "Bash(touch:*)",
      "Bash(ps:*)",
      "Bash(gh:*)",
      "Bash(ping:*)",
      "Bash(lsof:*)",
      "Bash(ln:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(date:*)",
      "Bash(md5:*)",
      "Bash(cut:*)"
    ],
    "ask": [
      "Bash(*pg-rw-query.py *)"
    ],
    "defaultMode": "auto"
  },
  "pluginConfigs": {
    "slack-pane@inline": {
      "options": {
        "mcpServer": "slack-demo"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "커피 수혈 중",
      "버그와 협상 중",
      "Stack Overflow 검색 중 아님",
      "더 나은 코드 고민 중",
      "테스트 통과 기도 중",
      "완벽한 한 줄을 찾는 중"
    ]
  },
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "switchModelsOnFlag": true,
  "syncClaudeAiSkills": false,
  "theme": "dark",
  "tui": "fullscreen"
}
