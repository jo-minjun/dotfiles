# Terminal colors
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

print_bold() { [[ -n "$1" ]] && echo -e "${BOLD}${1}${NC}"; }
print_green() { [[ -n "$1" ]] && echo -e "${GREEN}${1}${NC}"; }
print_yellow() { [[ -n "$1" ]] && echo -e "${YELLOW}${1}${NC}"; }
print_red() { [[ -n "$1" ]] && echo -e "${RED}${1}${NC}"; }

ls_command() {
  grep -E "^[a-z_]+\(\) \{" ~/Commands/command.sh | cut -d "(" -f 1
}

