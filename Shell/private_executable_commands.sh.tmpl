BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

print_bold() { [[ -n "$1" ]] && echo -e "${BOLD}${1}${NC}"; }
print_green() { [[ -n "$1" ]] && echo -e "${GREEN}${1}${NC}"; }
print_yellow() { [[ -n "$1" ]] && echo -e "${YELLOW}${1}${NC}"; }
print_red() { [[ -n "$1" ]] && echo -e "${RED}${1}${NC}"; }

# Clear screen and scrollback with Ctrl+K (Cmd+K via Ghostty)
clear-screen-and-scrollback() {
  printf '\x1b[2J\x1b[3J\x1b[H'
  zle reset-prompt
}
zle -N clear-screen-and-scrollback
bindkey '^k' clear-screen-and-scrollback

ls_shell() {
  print_green "Functions"
  echo "----------"
  grep -E "^[a-z_]+\(\) \{" ~/Shell/commands.sh | cut -d "(" -f 1
  echo ""
  print_green "Aliases"
  echo "----------"
  grep -E "^alias " ~/Shell/aliases.sh | sed 's/alias \([^=]*\)=.*/\1/'
}

chezmoi_work() {
  if [[ -z "$1" ]]; then
    print_bold "업무 dotfiles(chezmoi-work) 소스로 chezmoi를 실행합니다"
    echo ""
    echo "Usage: chezmoi_work <chezmoi 명령>"
    echo "  e.g. chezmoi_work diff"
    return 0
  fi
  chezmoi --source "$CHEZMOI_WORK_SOURCE" --persistent-state "$CHEZMOI_WORK_STATE" "$@"
}

# 1Password 서비스 어카운트 토큰을 키체인에서 읽어, 넘겨받은 명령에만 OP_SERVICE_ACCOUNT_TOKEN으로 넣는다
# 셸 전체에 export하면 chezmoi의 onepasswordRead(account 모드)가 실패하고 내 op 명령도 서비스 어카운트로 실행된다
# 키체인 항목은 chezmoi apply가 1Password Personal 금고에서 복사한다
# 이름을 _로 시작하지 않는다. Claude Code 셸 스냅샷이 _로 시작하는 함수를 빼서 with_me_sa·with_im_sa가 실패한다
with_op_sa() {
  if (( $# < 2 )); then
    print_bold "1Password 서비스 어카운트 토큰으로 명령을 실행합니다(with_me_sa, with_im_sa가 호출)"
    echo ""
    echo "Usage: with_op_sa <호출한 함수 이름> <서비스 어카운트> <명령> [인자...]"
    echo "  e.g. with_op_sa with_me_sa me-sa-agent op vault list"
    return 0
  fi
  local fn="$1" sa="$2"
  shift 2
  if [[ -z "$1" ]]; then
    print_bold "${sa} 서비스 어카운트 토큰으로 명령을 실행합니다"
    echo ""
    echo "Usage: ${fn} <명령> [인자...]"
    echo "  e.g. ${fn} op vault list"
    return 0
  fi
  local token
  token="$(security find-generic-password -a "$USER" -s "op-sa-${sa}" -w 2>/dev/null)"
  if [[ -z "$token" ]]; then
    print_red "키체인에 op-sa-${sa} 토큰이 없습니다. chezmoi apply를 실행하세요"
    return 1
  fi
  OP_SERVICE_ACCOUNT_TOKEN="$token" "$@"
}

with_me_sa() { with_op_sa with_me_sa me-sa-agent "$@"; }

_chezmoi_sync_repo() {
  local label="$1" source_dir="$2"
  shift 2

  print_bold "[$label] 변경사항을 반영합니다"
  # modify_ 로 관리하는 파일은 re-add 가 건너뛴다. 공개 소스에서만 본문을 따로 반영한다.
  [[ "$label" == dotfiles ]] && bash ~/.claude/skills/chezmoi-sync/scripts/capture-modify-files.sh
  "$@" re-add
  if [[ -z $(git -C "$source_dir" status --porcelain) ]]; then
    print_yellow "변경사항이 없습니다"
    echo ""
    return 0
  fi

  print_green "변경된 파일:"
  git -C "$source_dir" status --short
  echo ""

  print_bold "커밋 메시지를 입력하세요 (빈 입력시 건너뜀): "
  local message
  read -r message
  [[ -z "$message" ]] && return 0

  git -C "$source_dir" add -A
  git -C "$source_dir" commit -m "$message"
  git -C "$source_dir" push
  echo ""
}

chezmoi_sync() {
  print_bold "chezmoi 변경사항을 동기화합니다"
  echo ""

  _chezmoi_sync_repo dotfiles ~/.local/share/chezmoi chezmoi
  [[ -d "$CHEZMOI_WORK_SOURCE" ]] && _chezmoi_sync_repo dotfiles-work "$CHEZMOI_WORK_SOURCE" chezmoi_work

  print_bold "완료되었습니다"
}

port_kill() {
  if [[ -z "$1" ]]; then
    print_bold "Kill process by port"
    echo ""
    echo "Usage: port_kill <PORT>"
    echo "  e.g. port_kill 3000"
    return 0
  fi
  local pid
  pid=$(lsof -ti :"$1")
  if [[ -z "$pid" ]]; then
    print_yellow "포트 $1을 사용하는 프로세스가 없습니다"
    return 0
  fi
  print_green "포트 $1 프로세스(PID: $pid)를 종료합니다"
  kill -9 $pid
}

clean_container() {
  if [[ -z "$1" ]]; then
    print_green "전체 컨테이너를 정리합니다"
    docker container ls -a -q | xargs docker container stop
    docker container prune -f
    return 0
  fi

  print_green "$1 문자를 포함하는 컨테이너를 정리합니다"
  docker container ls -a | grep "$1" | awk '{print $1}' | xargs docker container stop
  docker container prune -f
}

dlogs() {
  if [[ -z "$1" ]]; then
    print_bold "Docker container logs"
    echo ""
    echo "Usage: dlogs <CONTAINER_ID>"
    return 0
  fi
  docker logs -f "$1" | jq -R '. as $line | try (fromjson) catch $line'
}

dshell() {
  if [[ -z "$1" ]]; then
    print_bold "Docker container shell"
    echo ""
    echo "Usage: dshell <CONTAINER_ID>"
    return 0
  fi
  docker container exec -it "$1" /bin/bash
}

klogs() {
  if [[ -z "$1" ]]; then
    print_bold "Kubernetes pod logs"
    echo ""
    echo "Usage: klogs <POD_ID>"
    return 0
  fi
  kubectl logs -f "$1" | jq -R '. as $line | try (fromjson) catch $line'
}

git_tag() {
  if [[ -z "$1" ]]; then
    print_bold "git tag를 최신화합니다"
    echo ""
    echo "Usage: git_tag <tag_name>"
    echo "  e.g. git_tag 1.0.0"
    return 0
  fi

  print_bold "버전을 선택해주세요."
  print_bold "--------------------"
  echo "  RELEASE   : [rR]"
  echo "  SNAPSHOT  : [sS]"
  echo "  HOTFIX    : [hH]"
  echo "  사용 안 함: [nN]"
  print_bold "--------------------"

  local tag_version=""
  read -r response
  case "$response" in
    [rR]) tag_version="-RELEASE" ;;
    [sS]) tag_version="-SNAPSHOT" ;;
    [hH]) tag_version="-HOTFIX" ;;
  esac

  local tag_name="$1$tag_version"
  print_yellow "태그 이름: $tag_name"
  echo ""

  print_bold "진행할까요? [y/N] "
  read -r response
  if [[ "$response" =~ ^[yY]$ ]]; then
    print_green "깃 태그 제거 중..."
    git tag -d "$tag_name"

    print_green "깃 태그 생성 중..."
    git tag "$tag_name"

    print_green "깃허브 태그 제거 중..."
    git push origin ":$tag_name"

    print_green "깃허브 태그 생성 중..."
    git push origin "$tag_name"
  fi
}

git_web() {
  local remote_url=$(git remote get-url origin 2>/dev/null)
  if [[ -z "$remote_url" ]]; then
    print_red "Not a git repository or no remote configured"
    return 1
  fi

  local web_url=$(echo "$remote_url" | sed -E 's#git@([^:]+):#https://\1/#' | sed 's#\.git$##')

  local branch=$(git branch --show-current 2>/dev/null)
  if [[ -n "$branch" && "$branch" != "main" && "$branch" != "master" ]]; then
    web_url="$web_url/tree/$branch"
  fi

  print_green "Opening: $web_url"
  open "$web_url"
}

mkd() {
  mkdir -p "$1" && cd "$1"
}

my_ip() {
  print_bold "Local IP:"
  ipconfig getifaddr en0 2>/dev/null || echo "Not connected"
  print_bold "Public IP:"
  curl -s ifconfig.me
  echo
}

yazicd() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}
