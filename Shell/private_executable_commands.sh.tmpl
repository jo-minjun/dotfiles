BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

print_bold() { [[ -n "$1" ]] && echo -e "${BOLD}${1}${NC}"; }
print_green() { [[ -n "$1" ]] && echo -e "${GREEN}${1}${NC}"; }
print_yellow() { [[ -n "$1" ]] && echo -e "${YELLOW}${1}${NC}"; }
print_red() { [[ -n "$1" ]] && echo -e "${RED}${1}${NC}"; }

ls_shell() {
  print_green "Functions"
  echo "----------"
  grep -E "^[a-z_]+\(\) \{" ~/Shell/commands.sh | cut -d "(" -f 1
  echo ""
  print_green "Aliases"
  echo "----------"
  grep -E "^alias " ~/Shell/aliases | sed 's/alias \([^=]*\)=.*/\1/'
}

chezmoi_sync() {
  print_bold "chezmoi 변경사항을 동기화합니다"
  echo ""

  chezmoi re-add
  cd ~/.local/share/chezmoi || return 1

  if [[ -z $(git status --porcelain) ]]; then
    print_yellow "변경사항이 없습니다"
    cd - > /dev/null
    return 0
  fi

  print_green "변경된 파일:"
  git status --short
  echo ""

  print_bold "커밋 메시지를 입력하세요 (빈 입력시 취소): "
  read -r message
  if [[ -z "$message" ]]; then
    cd - > /dev/null
    return 0
  fi

  git add -A
  git commit -m "$message"
  git push

  print_bold "완료되었습니다"
  cd - > /dev/null
}

port_kill() {
  if [[ -z "$1" ]]; then
    print_bold "Kill process by port"
    echo ""
    echo "Usage: port_kill <PORT>"
    echo "  e.g. port_kill 3000"
    return 0
  fi
  local pid
  pid=$(lsof -ti :"$1")
  if [[ -z "$pid" ]]; then
    print_yellow "포트 $1을 사용하는 프로세스가 없습니다"
    return 0
  fi
  print_green "포트 $1 프로세스(PID: $pid)를 종료합니다"
  kill -9 $pid
}

ecr_login() {
  local profile_opt=""
  [[ -n "$1" ]] && profile_opt="--profile $1"
  aws ecr get-login-password --region ap-northeast-2 $profile_opt | \
    docker login --username AWS --password-stdin 200327251464.dkr.ecr.ap-northeast-2.amazonaws.com
}

sync_refiner() {
  if [[ -z "$1" ]]; then
    print_bold "neogeorefiner 이미지를 최신화합니다"
    echo ""
    echo "Usage: sync_refiner <tag_name>"
    echo "  e.g. sync_refiner etpost-20220915030019"
    return 0
  fi

  local container
  container=$(docker inspect neogeorefiner --format "{{ "{{json .State.Status}}" }}" 2>/dev/null | xargs)
  if [[ "$container" == "running" ]]; then
    print_red "neogeorefiner docker container is running"
    echo ""
    print_yellow "cd vroong-neogeo && ./gradlew composeDown"
    return 0
  fi

  print_bold "기존 이미지를 지울까요? [y/N]"
  read -r response
  if [[ "$response" =~ ^[yY]$ ]]; then
    local candidate1 candidate2
    candidate1=$(docker image ls --filter=reference="neogeorefiner" --quiet)
    candidate2=$(docker image ls --filter=reference="200327251464.dkr.ecr.ap-northeast-2.amazonaws.com/vroong/neogeorefiner" --quiet)
    docker image rm $candidate1 $candidate2 --force
  fi

  print_green "ECR에 로그인합니다"
  aws ecr get-login-password --region ap-northeast-2 --profile meshtools | \
    docker login --username AWS --password-stdin 200327251464.dkr.ecr.ap-northeast-2.amazonaws.com

  echo ""
  print_green "이미지를 내려받습니다"
  docker pull "200327251464.dkr.ecr.ap-northeast-2.amazonaws.com/vroong/neogeorefiner:$1"

  echo ""
  print_green "neogeorefiner:latest 태그를 부여합니다"
  docker tag "200327251464.dkr.ecr.ap-northeast-2.amazonaws.com/vroong/neogeorefiner:$1" neogeorefiner:latest

  echo ""
  print_bold "완료되었습니다"
}

clean_container() {
  if [[ -z "$1" ]]; then
    print_green "전체 컨테이너를 정리합니다"
    docker container ls -a -q | xargs docker container stop
    docker container prune -f
    return 0
  fi

  print_green "$1 문자를 포함하는 컨테이너를 정리합니다"
  docker container ls -a | grep "$1" | awk '{print $1}' | xargs docker container stop
  docker container prune -f
}

dlogs() {
  if [[ -z "$1" ]]; then
    print_bold "Docker container logs"
    echo ""
    echo "Usage: dlogs <CONTAINER_ID>"
    return 0
  fi
  docker logs -f "$1" | jq -R '. as $line | try (fromjson) catch $line'
}

dshell() {
  if [[ -z "$1" ]]; then
    print_bold "Docker container shell"
    echo ""
    echo "Usage: dshell <CONTAINER_ID>"
    return 0
  fi
  docker container exec -it "$1" /bin/bash
}

klogs() {
  if [[ -z "$1" ]]; then
    print_bold "Kubernetes pod logs"
    echo ""
    echo "Usage: klogs <POD_ID>"
    return 0
  fi
  kubectl logs -f "$1" | jq -R '. as $line | try (fromjson) catch $line'
}

git_tag() {
  if [[ -z "$1" ]]; then
    print_bold "git tag를 최신화합니다"
    echo ""
    echo "Usage: git_tag <tag_name>"
    echo "  e.g. git_tag 1.0.0"
    return 0
  fi

  print_bold "버전을 선택해주세요."
  print_bold "--------------------"
  echo "  RELEASE   : [rR]"
  echo "  SNAPSHOT  : [sS]"
  echo "  HOTFIX    : [hH]"
  echo "  사용 안 함: [nN]"
  print_bold "--------------------"

  local tag_version=""
  read -r response
  case "$response" in
    [rR]) tag_version="-RELEASE" ;;
    [sS]) tag_version="-SNAPSHOT" ;;
    [hH]) tag_version="-HOTFIX" ;;
  esac

  local tag_name="$1$tag_version"
  print_yellow "태그 이름: $tag_name"
  echo ""

  print_bold "진행할까요? [y/N] "
  read -r response
  if [[ "$response" =~ ^[yY]$ ]]; then
    print_green "깃 태그 제거 중..."
    git tag -d "$tag_name"

    print_green "깃 태그 생성 중..."
    git tag "$tag_name"

    print_green "깃허브 태그 제거 중..."
    git push origin ":$tag_name"

    print_green "깃허브 태그 생성 중..."
    git push origin "$tag_name"
  fi
}
