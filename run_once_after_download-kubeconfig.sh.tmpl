{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Download kubeconfig from 1Password (one-time only)

set -e

VAULT="Secrets"
DEST="$HOME/.kube/config"

# Check if op is installed
if ! command -v op &>/dev/null; then
  echo "1Password CLI not installed. Skipping kubeconfig download."
  exit 0
fi

# Check if signed in
if ! op account list &>/dev/null 2>&1; then
  echo "1Password CLI not signed in. Skipping kubeconfig download."
  exit 0
fi

# Check if document exists in 1Password
if ! op document get "Kubeconfig" --vault "$VAULT" &>/dev/null 2>&1; then
  echo "Kubeconfig not found in 1Password. Skipping."
  exit 0
fi

# Download kubeconfig
echo "Downloading kubeconfig from 1Password..."
mkdir -p "$(dirname "$DEST")"
op document get "Kubeconfig" --vault "$VAULT" > "$DEST"
chmod 600 "$DEST"
echo "Kubeconfig downloaded to $DEST"
{{- end }}
