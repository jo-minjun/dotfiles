{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Build web apps using Pake

set -e
source "$HOME/.cargo/env" 2>/dev/null || true
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"

APPS_DIR="/Applications"
ICON_DIR="$HOME/.config/pake"

# Format: "App Name|URL|Icon"
WEB_APPS=(
  "Google Gemini|https://gemini.google.com/app|$ICON_DIR/gemini.png"
)

for entry in "${WEB_APPS[@]}"; do
  IFS='|' read -r name url icon <<< "$entry"

  if [[ -d "$APPS_DIR/$name.app" ]]; then
    echo "$name already exists, skipping."
    continue
  fi

  echo "Building $name..."
  pake "$url" --name "$name" --icon "$icon"
  [[ -d "$name.app" ]] && mv "$name.app" "$APPS_DIR/"
done

echo "Web apps build complete."
{{- end }}
