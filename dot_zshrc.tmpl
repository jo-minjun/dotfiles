# Enable Powerlevel10k instant prompt (keep at top of file)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh configuration
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git docker kubectl aws)

source $ZSH/oh-my-zsh.sh

# Custom commands and aliases
source ~/Commands/command.sh
source ~/Commands/alias
[[ -f ~/.secrets.zsh ]] && source ~/.secrets.zsh

# Powerlevel10k theme
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Runtime version manager
eval "$(mise activate zsh)"

# PATH additions
export PATH="/opt/homebrew/opt/node@24/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"

# Claude Code configuration
export CLAUDE_BIN_PATH=/opt/homebrew/bin/claude
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true
export ENABLE_LSP_TOOL=1

# zsh-syntax-highlighting (must be at end of .zshrc)
source ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
