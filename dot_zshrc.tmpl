# Enable Powerlevel10k instant prompt (keep at top of file)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh configuration
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git docker kubectl aws fzf z)

source $ZSH/oh-my-zsh.sh

# Custom commands and aliases
source ~/Shell/commands.sh
source ~/Shell/aliases.sh
source ~/Shell/exports.sh
[[ -f ~/.secrets.zsh ]] && source ~/.secrets.zsh

# Powerlevel10k theme
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Runtime version manager
eval "$(mise activate zsh)"

# Smart directory jumper
eval "$(zoxide init zsh)"

# gh는 활성 계정 하나만 쓰므로, 셸마다 디렉터리에 맞는 계정 토큰을 GH_TOKEN으로 지정한다
_gh_account_for_dir() {
  local account=jo-minjun
  [[ "${PWD:l}/" == "${HOME:l}/projects/work/"* ]] && account=***WORK_GH_ACCOUNT***
  [[ "$account" == "$_GH_ACCOUNT" ]] && return
  _GH_ACCOUNT=$account
  local token
  token="$(gh auth token --user "$account" 2>/dev/null)"
  if [[ -n "$token" ]]; then
    export GH_TOKEN="$token"
  else
    unset GH_TOKEN
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _gh_account_for_dir
_gh_account_for_dir

# SSH 환경에서 Ghostty 터미널 호환성 설정
if [[ -n "$SSH_CONNECTION" && "$TERM" == "xterm-ghostty" ]]; then
  export TERM=xterm-256color
fi

# zsh-syntax-highlighting (must be at end of .zshrc)
source ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

export PATH="$HOME/.local/bin:$PATH"
