{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -e

[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "=== 1Password 상태 확인 ==="

# 로그인 상태 확인
if ! op account list &>/dev/null 2>&1; then
  echo -e "${YELLOW}[WARN]${NC} 1Password CLI에 로그인되지 않았습니다."
  echo ""
  echo "설정 방법:"
  echo "  1. 1Password 앱 실행"
  echo "  2. 설정 > 개발자 > 'CLI와의 생체 인증 잠금 해제' 활성화"
  echo "  3. 터미널에서: eval \$(op signin)"
  echo ""
  echo "설정 후 다시 실행: chezmoi apply"
  exit 1
fi

echo -e "${GREEN}[OK]${NC} 1Password CLI 연결됨"
{{- end }}
