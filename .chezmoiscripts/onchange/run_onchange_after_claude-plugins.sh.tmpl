#!/bin/bash
set -e

# settings.json hash: {{ include "dot_claude/private_settings.json" | sha256sum }}

# Initialize Homebrew PATH (Apple Silicon)
[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

if ! command -v claude &>/dev/null; then
  echo "Claude Code CLI not found. Skipping plugin installation."
  exit 0
fi

SETTINGS_FILE="{{ .chezmoi.homeDir }}/.claude/settings.json"

if [[ ! -f "$SETTINGS_FILE" ]]; then
  echo "Claude settings.json not found. Skipping."
  exit 0
fi

echo "=== Claude Code Plugin Installation ==="

get_marketplace_repo() {
  local from_settings
  from_settings=$(jq -r --arg name "$1" '.extraKnownMarketplaces[$name].source.repo // empty' "$SETTINGS_FILE" 2>/dev/null)
  if [[ -n "$from_settings" ]]; then
    echo "$from_settings"
    return
  fi
  case "$1" in
    claude-dashboard) echo "uppinote20/claude-dashboard" ;;
    anthropic-agent-skills) echo "anthropics/skills" ;;
    *) echo "" ;;
  esac
}

PLUGINS=$(jq -r '.enabledPlugins | keys[]' "$SETTINGS_FILE" 2>/dev/null || echo "")

if [[ -z "$PLUGINS" ]]; then
  echo "No plugins found in settings.json"
  exit 0
fi

INSTALLED_MARKETPLACES=$(claude plugin marketplace list 2>/dev/null || echo "")

echo "Checking marketplaces..."
for plugin in $PLUGINS; do
  marketplace="${plugin#*@}"
  [[ "$marketplace" == "claude-plugins-official" ]] && continue

  if echo "$INSTALLED_MARKETPLACES" | grep -q "$marketplace"; then
    echo "  [OK] $marketplace"
    continue
  fi

  repo=$(get_marketplace_repo "$marketplace")
  if [[ -n "$repo" ]]; then
    echo "  [+] Adding marketplace: $marketplace"
    claude plugin marketplace add "$repo" || echo "  [!] Warning: Failed to add $marketplace"
  fi
done

echo ""
echo "Installing plugins..."
for plugin in $PLUGINS; do
  echo "  [+] $plugin"
  claude plugin install "$plugin" 2>/dev/null || echo "  [!] Warning: Failed to install $plugin"
done

echo ""
echo "Removing plugins not listed in enabledPlugins..."
INSTALLED_PLUGINS=$(claude plugin list 2>/dev/null | awk '/^  ❯/ {print $2}' || echo "")
DESIRED_SORTED=$(echo "$PLUGINS" | sort)
INSTALLED_SORTED=$(echo "$INSTALLED_PLUGINS" | sort)
TO_REMOVE=$(comm -23 <(echo "$INSTALLED_SORTED") <(echo "$DESIRED_SORTED"))

if [[ -z "$TO_REMOVE" ]]; then
  echo "  [OK] Nothing to remove"
else
  for plugin in $TO_REMOVE; do
    [[ -z "$plugin" ]] && continue
    echo "  [-] $plugin"
    claude plugin uninstall "$plugin" 2>/dev/null || echo "  [!] Warning: Failed to uninstall $plugin"
  done
fi

echo ""
echo "=== Plugin installation complete ==="
