{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Install Rust and pake-cli for building web apps

set -e

export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"

# Initialize Rust
if ! command -v rustc &>/dev/null; then
  echo "Initializing Rust..."
  rustup-init -y --no-modify-path
fi
source "$HOME/.cargo/env" 2>/dev/null || true

# Setup pnpm
pnpm config get global-bin-dir &>/dev/null || pnpm setup

# Install pake-cli
command -v pake &>/dev/null || pnpm install -g pake-cli

echo "Pake setup complete."
{{- end }}
