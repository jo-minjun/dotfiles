{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Download documents from 1Password (one-time only)

set -e

VAULT="Secrets"

# Check if 1Password CLI is available and signed in
check_op_status() {
  if ! command -v op &>/dev/null; then
    echo "1Password CLI not installed. Skipping document downloads."
    return 1
  fi

  if ! op account list &>/dev/null 2>&1; then
    echo "1Password CLI not signed in. Skipping document downloads."
    return 1
  fi

  return 0
}

# Download a document from 1Password
# Args: $1=document_name, $2=destination_path, $3=permissions
download_document() {
  local doc_name="$1"
  local dest_path="$2"
  local permissions="${3:-600}"

  if ! op document get "$doc_name" --vault "$VAULT" &>/dev/null 2>&1; then
    echo "$doc_name not found in 1Password. Skipping."
    return 0
  fi

  echo "Downloading $doc_name from 1Password..."
  mkdir -p "$(dirname "$dest_path")"
  op document get "$doc_name" --vault "$VAULT" > "$dest_path"
  chmod "$permissions" "$dest_path"
  echo "$doc_name downloaded to $dest_path"
}

# Main
check_op_status || exit 0

download_document "Kubeconfig" "$HOME/.kube/config" 600
download_document "AWS Credentials" "$HOME/.aws/credentials" 600
{{- end }}
