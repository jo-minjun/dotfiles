{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# 셸 함수 with_me_sa가 쓰는 서비스 어카운트 토큰을 1Password Personal 금고에서 키체인으로 복사한다
# 키체인에 이미 있으면 건너뛴다. 토큰을 바꿨으면 키체인 항목을 지운 뒤 다시 apply한다
# 토큰은 화면과 파일에 남기지 않고 security -i의 표준 입력으로만 넘긴다

set -euo pipefail

SA_NAME="me-sa-agent"
SERVICE="op-sa-${SA_NAME}"
ITEM="1Password Service Account: ${SA_NAME}"

if security find-generic-password -a "$USER" -s "$SERVICE" >/dev/null 2>&1; then
  exit 0
fi

# Initialize Homebrew PATH (Apple Silicon)
[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

if ! command -v op &>/dev/null; then
  echo "1Password CLI가 없어 ${SERVICE} 키체인 등록을 건너뜁니다"
  exit 0
fi

token="$(op item get "$ITEM" --vault Personal --fields credential --reveal 2>/dev/null)" || token=""
if [[ -z "$token" ]]; then
  echo "1Password Personal 금고에 '${ITEM}' 항목이 없어 ${SERVICE} 키체인 등록을 건너뜁니다"
  exit 0
fi

printf 'add-generic-password -U -a "%s" -s "%s" -w "%s"\n' "$USER" "$SERVICE" "$token" | security -i >/dev/null
unset token
echo "${SERVICE} 토큰을 키체인에 등록했습니다"
{{- end }}
