{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Download AWS credentials from 1Password (one-time only)

set -e

VAULT="Secrets"
DEST="$HOME/.aws/credentials"

# Check if op is installed
if ! command -v op &>/dev/null; then
  echo "1Password CLI not installed. Skipping AWS credentials download."
  exit 0
fi

# Check if signed in
if ! op account list &>/dev/null 2>&1; then
  echo "1Password CLI not signed in. Skipping AWS credentials download."
  exit 0
fi

# Check if document exists in 1Password
if ! op document get "AWS Credentials" --vault "$VAULT" &>/dev/null 2>&1; then
  echo "AWS Credentials not found in 1Password. Skipping."
  exit 0
fi

# Download AWS credentials
echo "Downloading AWS credentials from 1Password..."
mkdir -p "$(dirname "$DEST")"
op document get "AWS Credentials" --vault "$VAULT" > "$DEST"
chmod 600 "$DEST"
echo "AWS credentials downloaded to $DEST"
{{- end }}
