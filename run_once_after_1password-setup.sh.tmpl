{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Create 1Password items for secrets (if not exist)

set -e

VAULT="Secrets"

# Check if op is installed
if ! command -v op &>/dev/null; then
  echo "1Password CLI not installed. Run 'brew bundle' first."
  exit 0
fi

# Check if 1Password app is installed
if [[ ! -d "/Applications/1Password.app" ]]; then
  echo "1Password app not installed. Please install it first."
  exit 0
fi

# Check if signed in
if ! op account list &>/dev/null 2>&1; then
  echo "Please sign in to 1Password CLI first: eval \$(op signin)"
  echo "Then run 'chezmoi apply' again."
  exit 0
fi

# Create vault if not exists
if ! op vault get "$VAULT" &>/dev/null 2>&1; then
  echo "Creating vault: $VAULT"
  op vault create "$VAULT"
fi

# Helper function to create item if not exists
create_if_not_exists() {
  local title="$1"
  local category="$2"

  if ! op item get "$title" --vault "$VAULT" &>/dev/null 2>&1; then
    echo "Creating item: $title"
    op item create --category "$category" --title "$title" --vault "$VAULT" \
      username="" password=""
    echo "  -> Created. Please fill in the credentials in 1Password app."
  else
    echo "Item already exists: $title"
  fi
}

# Helper function to upload document if not exists
upload_document_if_not_exists() {
  local title="$1"
  local source_file="$2"

  if ! op document get "$title" --vault "$VAULT" &>/dev/null 2>&1; then
    if [[ -f "$source_file" ]]; then
      echo "Uploading document: $title"
      op document create "$source_file" --vault "$VAULT" --title "$title"
      echo "  -> Uploaded from $source_file"
    else
      echo "Document not found in 1Password and source file missing: $source_file"
      echo "  -> Please create '$title' document in 1Password manually."
    fi
  else
    echo "Document already exists: $title"
  fi
}

# Create login items
create_if_not_exists "Docker Hub" "login"
create_if_not_exists "GitHub Token" "login"

# Upload config file documents
upload_document_if_not_exists "Kubeconfig" "$HOME/.kube/config"
upload_document_if_not_exists "AWS Credentials" "$HOME/.aws/credentials"

echo ""
echo "1Password items setup complete."
echo "Please fill in the actual credentials in 1Password app before running 'chezmoi apply' again."
{{- end }}
