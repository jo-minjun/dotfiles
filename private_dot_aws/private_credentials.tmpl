{{- $opExists := lookPath "op" -}}
{{- if $opExists -}}
{{-   $checkResult := output "sh" "-c" "op document get 'AWS Credentials' --vault 'Secrets' > /dev/null 2>&1 && echo exists || echo missing" | trim -}}
{{-   if eq $checkResult "exists" -}}
{{ onepasswordDocument "AWS Credentials" "Secrets" }}
{{-   else -}}
# AWS credentials not found in 1Password.
# Run: chezmoi apply (to create the document), then chezmoi apply again.
{{-   end -}}
{{- else -}}
# 1Password CLI not installed. Run: brew install 1password-cli && op signin
{{- end }}
