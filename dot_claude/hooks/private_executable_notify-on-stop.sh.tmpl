#!/bin/bash

INPUT=$(cat)

if [ "$(echo "$INPUT" | jq -r '.stop_hook_active')" = "true" ]; then
  exit 0
fi

WEBHOOK_URL="{{ (index (onepassword "Slack Webhook - Claude Notify" "Secrets").urls 0).href }}"
CWD=$(echo "$INPUT" | jq -r '.cwd')
SESSION_ID=$(echo "$INPUT" | jq -r '.session_id')
TRANSCRIPT_PATH=$(echo "$INPUT" | jq -r '.transcript_path')

# 위치: git repo → 프로젝트명(브랜치), 아니면 경로
if git -C "$CWD" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  PROJECT=$(basename "$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)")
  BRANCH=$(git -C "$CWD" branch --show-current 2>/dev/null || echo "detached")
  LOCATION="\`${PROJECT}\` - \`${BRANCH}\`"
else
  LOCATION="\`${CWD}\`"
fi

# 소요시간: 마지막 사용자 메시지 ~ 현재
DURATION="-"
if [ -f "$TRANSCRIPT_PATH" ]; then
  LAST_USER_TS=$(jq -r 'select(.type == "user" and (.message.content | type) == "string" and (.isMeta | not)) | .timestamp // empty' "$TRANSCRIPT_PATH" 2>/dev/null | tail -1)
  if [ -n "$LAST_USER_TS" ]; then
    START_EPOCH=$(date -j -u -f "%Y-%m-%dT%H:%M:%S" "${LAST_USER_TS%%.*}" "+%s" 2>/dev/null)
    NOW_EPOCH=$(date "+%s")
    if [ -n "$START_EPOCH" ]; then
      ELAPSED=$((NOW_EPOCH - START_EPOCH))
      if [ "$ELAPSED" -lt 300 ]; then
        exit 0
      fi
      if [ "$ELAPSED" -ge 3600 ]; then
        DURATION="$((ELAPSED / 3600))시간 $(((ELAPSED % 3600) / 60))분"
      elif [ "$ELAPSED" -ge 60 ]; then
        DURATION="$((ELAPSED / 60))분 $((ELAPSED % 60))초"
      else
        DURATION="${ELAPSED}초"
      fi
    fi
  fi
fi

# 작업 요약: transcript에서 마지막 사용자 메시지 추출
SUMMARY="-"
if [ -f "$TRANSCRIPT_PATH" ]; then
  LAST_MSG=$(jq -r 'select(.type == "user") | .message.content | if type == "string" then . else empty end' "$TRANSCRIPT_PATH" 2>/dev/null | tail -1 | tr '\n' ' ' | cut -c 1-100)
  if [ -n "$LAST_MSG" ]; then
    SUMMARY="$LAST_MSG"
  fi
fi

# Slack 전송
PAYLOAD=$(jq -n \
  --arg location "$LOCATION" \
  --arg duration "$DURATION" \
  --arg summary "$SUMMARY" \
  --arg session "$SESSION_ID" \
  '{
    "blocks": [
      {
        "type": "header",
        "text": {
          "type": "plain_text",
          "text": "민준님, 작업이 완료되었습니다!"
        }
      },
      {
        "type": "section",
        "fields": [
          { "type": "mrkdwn", "text": ("*:file_folder: 위치*\n" + $location) },
          { "type": "mrkdwn", "text": ("*:stopwatch: 소요시간*\n" + $duration) }
        ]
      },
      {
        "type": "section",
        "text": {
          "type": "mrkdwn",
          "text": (">>> " + $summary)
        }
      },
      {
        "type": "context",
        "elements": [
          { "type": "mrkdwn", "text": ("session: `" + $session + "`") }
        ]
      }
    ]
  }')

curl -s -X POST "$WEBHOOK_URL" \
  -H 'Content-type: application/json' \
  -d "$PAYLOAD" \
  > /dev/null 2>&1

exit 0
