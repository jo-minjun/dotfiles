{{- /* chezmoi:modify-template */ -}}
{{- /* 본문은 .chezmoitemplates/paseo/config.json 이다. daemon.auth(비밀번호 해시)는 공개 저장소에 두지 않고 현재 파일의 값을 유지한다 */ -}}
{{- /* plugins는 paseo plugin install이 기기마다 다른 경로로 쓰므로 현재 파일의 값을 유지한다. 설치는 run_after_paseo-plugins가 한다 */ -}}
{{- $result := includeTemplate "paseo/config.json" . | fromJson -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $current := fromJson .chezmoi.stdin -}}
{{-   $auth := dig "daemon" "auth" "" $current -}}
{{-   if $auth -}}
{{-     $_ := set $result.daemon "auth" $auth -}}
{{-   end -}}
{{-   if hasKey $current "plugins" -}}
{{-     $_ := set $result "plugins" $current.plugins -}}
{{-   end -}}
{{- end -}}
{{- toPrettyJson $result -}}
