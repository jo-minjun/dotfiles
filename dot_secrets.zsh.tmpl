{{- $opInstalled := false -}}
{{- $opOutput := "" -}}
{{- if lookPath "op" -}}
{{-   $opInstalled = true -}}
{{- end -}}
{{- if $opInstalled }}
# ===========================================
# Secrets from 1Password (Secrets vault)
# ===========================================

export DOCKER_HUB_PASSWORD="{{ (onepasswordDetailsFields "Docker Hub" "Secrets").password.value }}"

export AWS_ACCESS_KEY_ID_MESHDEV="{{ (onepasswordDetailsFields "AWS meshdev" "Secrets").username.value }}"
export AWS_SECRET_ACCESS_KEY_MESHDEV="{{ (onepasswordDetailsFields "AWS meshdev" "Secrets").password.value }}"

export AWS_ACCESS_KEY_ID_MESHLABS="{{ (onepasswordDetailsFields "AWS meshlabs" "Secrets").username.value }}"
export AWS_SECRET_ACCESS_KEY_MESHLABS="{{ (onepasswordDetailsFields "AWS meshlabs" "Secrets").password.value }}"
{{- else }}
# ===========================================
# 1Password CLI not installed
# Run: brew install 1password-cli && op signin
# Then: chezmoi apply
# ===========================================
{{- end }}
