# ===========================================
# 시크릿 환경변수 설정
# ===========================================
# 이 파일은 dotfiles 저장소에 포함되지 않습니다.
# 새 머신에서 아래 변수들을 직접 설정하세요.
#
# 사용 방법:
# 1. 이 파일을 ~/.secrets.zsh로 복사
# 2. 아래 변수들의 값을 채워넣기
# 3. source ~/.zshrc 또는 터미널 재시작
# ===========================================

# Docker Hub (command.sh에서 사용)
# export DOCKER_HUB_PASSWORD=""

# AWS Credentials - meshdev (default와 동일)
# ~/.aws/credentials 템플릿에서 사용
# export AWS_ACCESS_KEY_ID_MESHDEV=""
# export AWS_SECRET_ACCESS_KEY_MESHDEV=""

# AWS Credentials - meshlabs
# export AWS_ACCESS_KEY_ID_MESHLABS=""
# export AWS_SECRET_ACCESS_KEY_MESHLABS=""

# 기타 API 키
# export GITHUB_TOKEN=""
