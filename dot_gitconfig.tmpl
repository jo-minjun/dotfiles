[user]
	name = {{ .name }}
	email = {{ .email }}

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true
	paging = always

[merge]
	conflictStyle = zdiff3

# gh auth git-credential은 활성 계정 토큰만 반환하므로, 계정을 지정해 토큰을 받는다
[credential "https://github.com"]
	helper = 
	helper = "!f() { test \"$1\" = get && echo username=jo-minjun && echo \"password=$(/opt/homebrew/bin/gh auth token --user jo-minjun)\"; }; f"

[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

# 업무 디렉터리 설정이 위 기본값을 덮어쓰도록 마지막에 둔다
[includeIf "gitdir/i:~/Projects/work/"]
	path = ~/Projects/work/work.inc
